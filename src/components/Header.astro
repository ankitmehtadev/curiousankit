---
import Logo from './Logo.astro';
import { LINKS, NAV, NAV_HINTS } from '../consts';

const path = Astro.url.pathname;
// Posts count as part of their stream for the "you are here" marker.
const section = (href: string) => {
  if (href === '/ai-journey/') return /^\/(ai-journey|notes|experiments)(\/|$)/.test(path);
  return path === href || path.startsWith(href) || path + '/' === href;
};
---

<header class="site-header wrap">
  <a class="home" href="/" aria-label="Curious Ankit, home"><Logo size={32} /></a>

  <nav class="desk" aria-label="Main">
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={section(item.href) ? 'page' : undefined}>
          {section(item.href) && <span aria-hidden="true">→ </span>}
          {item.label}
        </a>
      ))
    }
    <a class="search" href="/archive/#search" aria-label="Search the archive">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6.5" cy="6.5" r="5"></circle><path d="M10.5 10.5 15 15"></path></svg>
    </a>
    <a class="sub" href="/subscribe/">Subscribe</a>
  </nav>

  <div class="phone-actions">
  <a class="m-search" href="/archive/#search" aria-label="Search the archive">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6.5" cy="6.5" r="5"></circle><path d="M10.5 10.5 15 15"></path></svg>
  </a>
  <button class="open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
    <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 1h18M0 6h18M0 11h18"></path></svg>
  </button>
  </div>
</header>

<div id="menu" class="menu" hidden>
  <div class="menu-top">
    <a href="/" aria-label="Curious Ankit, home"><Logo size={24} /></a>
    <button class="close" type="button" aria-label="Close menu">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 1 15 15M15 1 1 15"></path></svg>
    </button>
  </div>
  <nav class="menu-nav" aria-label="Main">
    <div class="streams">
      <a class="s-red" href="/ai-journey/"><span class="mono">Stream 01</span><span class="big">AI<br />Journey</span></a>
      <a class="s-white" href="/rabbit-holes/"><span class="mono">Stream 02</span><span class="big">Rabbit<br />Holes</span></a>
    </div>
    {
      NAV.slice(2).map((item) => (
        <a class="row" href={item.href} aria-current={section(item.href) ? 'page' : undefined}>
          <span class="big">{item.label}</span>
          <span class="mono hint">{NAV_HINTS[item.label]}</span>
        </a>
      ))
    }
  </nav>
  <div class="menu-foot">
    <a class="btn" href="/subscribe/">Subscribe</a>
    <div class="mono links">
      <span>
        <a href={LINKS.github}>GitHub</a>
        {LINKS.linkedin && <> · <a href={LINKS.linkedin}>LinkedIn</a></>}
        {' · '}<a href="/rss.xml">RSS</a>
      </span>
      <span>Melbourne</span>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById('menu');
  const openBtn = document.querySelector<HTMLButtonElement>('.site-header .open');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.close');

  function setOpen(open: boolean) {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  }
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setOpen(false);
  });
  matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 28px;
    padding-bottom: 32px;
  }
  .home {
    text-decoration: none;
    flex: 0 0 auto;
  }
  .desk {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 8px 28px;
    font-family: var(--mono);
    font-size: 13px;
  }
  .desk a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .desk a:hover,
  .desk a[aria-current='page'] {
    color: var(--red);
  }
  .desk .search {
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .desk .search:hover {
    border-color: var(--white);
    color: var(--white);
  }
  .desk .sub {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    background: var(--red);
    color: var(--white);
    transition: background 0.2s;
  }
  .desk .sub:hover {
    background: var(--red-deep);
    color: var(--white);
  }
  .phone-actions {
    display: none;
    gap: 8px;
  }
  .m-search {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .open {
    display: flex;
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--red);
    color: var(--white);
    align-items: center;
    justify-content: center;
  }

  /* Phone menu: a full screen sheet. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    background: var(--ink);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu a {
    text-decoration: none;
  }
  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
  }
  .close {
    width: 44px;
    height: 44px;
    border: 1px solid var(--white);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .menu-nav {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 24px 16px 0;
  }
  .streams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 24px;
  }
  .streams a {
    min-height: 150px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .streams .mono {
    font-size: 11px;
  }
  .streams .big {
    font-weight: 800;
    font-size: 30px;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .s-red {
    background: var(--red);
  }
  .s-white {
    background: var(--white);
    color: var(--ink);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .row .big {
    font-weight: 800;
    font-size: 44px;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .row[aria-current='page'] .big {
    color: var(--red);
  }
  .hint {
    font-size: 12px;
    color: var(--smoke);
  }
  .menu-foot {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .menu-foot .btn {
    min-height: 52px;
  }
  .links {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--smoke);
  }

  @media (max-width: 899px) {
    .site-header {
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .home :global(.logo) {
      font-size: 24px !important;
    }
    .desk {
      display: none;
    }
    .phone-actions {
      display: flex;
    }
  }
</style>
