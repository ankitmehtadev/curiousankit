---
import Logo from './Logo.astro';
import { DIVES, WHYS } from '../consts';
import { getDives, getWhys } from '../utils';

// A section only shows in the menu once it has at least one post.
const [whys, dives] = await Promise.all([getWhys(), getDives()]);
const nav = [
  ...(dives.length ? [{ label: DIVES.label, href: DIVES.href }] : []),
  ...(whys.length ? [{ label: WHYS.label, href: WHYS.href }] : []),
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
const here = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap inner">
    <a class="home" href="/" aria-label="Curious Ankit, home"><Logo size={20} /></a>
    <nav aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--line-soft);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 16px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .home {
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    font-size: 14px;
  }
  nav a {
    text-decoration: none;
    color: var(--ink);
    padding: 8px 0;
  }
  nav a:hover {
    color: var(--muted);
  }
  nav a[aria-current='page'] {
    font-weight: 600;
  }
  @media (max-width: 480px) {
    nav {
      gap: 8px 18px;
      font-size: 13px;
    }
  }
</style>
