---
import { NAV } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Curious Ankit, home">
      <span class="rule" aria-hidden="true"></span>
      <span class="stack">
        <span class="first">Curious</span>
        <span class="second">Ankit</span>
      </span>
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="start" href="/start">Start here</a></li>
        <li>
          <a class="search" href="/search">
            <span class="sr-only">Search</span>
            <svg viewBox="0 0 18 18" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <circle cx="7.5" cy="7.5" r="5.5"></circle>
              <path d="M11.8 11.8 16 16"></path>
            </svg>
          </a>
        </li>
        <li>
          <button class="theme" type="button" aria-label="Switch to dark mode">
            <svg class="moon" viewBox="0 0 18 18" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15.4 10.4A6.7 6.7 0 0 1 7.6 2.6a6.7 6.7 0 1 0 7.8 7.8Z"></path>
            </svg>
            <svg class="sun" viewBox="0 0 18 18" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <circle cx="9" cy="9" r="3.2"></circle>
              <path d="M9 1.4v1.7M9 14.9v1.7M1.4 9h1.7M14.9 9h1.7M3.6 3.6l1.2 1.2M13.2 13.2l1.2 1.2M3.6 14.4l1.2-1.2M13.2 4.8l1.2-1.2"></path>
            </svg>
            <span class="label">Dark mode</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.toggle');
  const themeButton = header?.querySelector<HTMLButtonElement>('.theme');
  const themeLabel = themeButton?.querySelector<HTMLElement>('.label');

  toggle?.addEventListener('click', () => {
    if (!header) return;
    const open = header.toggleAttribute('data-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  function showThemeState() {
    const dark = root.dataset.theme === 'dark';
    themeButton?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    if (themeLabel) themeLabel.textContent = dark ? 'Light mode' : 'Dark mode';
  }
  showThemeState();

  themeButton?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    showThemeState();
  });

  // Until a choice is saved, follow the device setting as it changes.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {}
    if (saved === 'dark' || saved === 'light') return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    showThemeState();
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 0;
  }
  .wordmark {
    display: flex;
    align-items: stretch;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .rule {
    width: 1.5px;
    background: var(--ink);
  }
  .stack {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-title);
  }
  .first {
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.005em;
  }
  .second {
    margin-top: 0.12rem;
    font-size: 1.15rem;
    font-weight: 500;
    font-style: italic;
    color: var(--muted);
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: 1.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--ink);
    font-size: 0.82rem;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
  nav a.start {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--ink);
    text-decoration: none;
  }
  nav a.start:hover {
    background: var(--ink);
    color: var(--paper);
  }
  nav a.search {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .theme {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .theme .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme .moon {
    display: none;
  }
  .theme .label {
    display: none;
    font-size: 0.95rem;
  }
  .toggle {
    display: none;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .bars {
    display: block;
    width: 22px;
    height: 8px;
    border-top: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
  }

  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
    }
    .toggle {
      display: block;
    }
    nav {
      display: none;
      flex-basis: 100%;
      margin-top: 1rem;
      border-top: 1px solid var(--rule);
    }
    .site-header[data-open] nav {
      display: block;
    }
    nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.6rem 0 0.4rem;
    }
    nav li {
      width: 100%;
    }
    nav a {
      display: block;
      padding: 0.6rem 0;
      font-size: 0.95rem;
    }
    nav a.start {
      display: inline-block;
      margin: 0.4rem 0;
      padding: 0.5rem 1rem;
    }
    .theme {
      padding: 0.6rem 0;
    }
    .theme .label {
      display: inline;
    }
  }
</style>
