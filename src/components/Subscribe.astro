---
// The centred email sign up band. variant="dark" is the near-black band, "light" the grey one.
import { LINKS, SUBSCRIBE_ACTION, SUBSCRIBE_FIELD } from '../consts';

interface Props {
  id?: string;
  title?: string;
  text?: string;
  variant?: 'dark' | 'light';
}
const {
  id = 'subscribe',
  title = 'One short story, every week.',
  text = "The week's Everyday Why in your inbox. No spam.",
  variant = 'dark',
} = Astro.props;
const inputId = `${id}-email`;
---

<section id={id} class:list={['subscribe', variant]} aria-labelledby={`${id}-title`}>
  <div class="wrap inner">
    <h2 id={`${id}-title`}>{title}</h2>
    {text && <p class="text">{text}</p>}
    <form
      class="sub-form"
      action={SUBSCRIBE_ACTION || undefined}
      method="post"
      target={SUBSCRIBE_ACTION ? '_blank' : undefined}
      data-fallback={SUBSCRIBE_ACTION ? undefined : LINKS.email}
    >
      <label for={inputId} class="sr-only">Email address</label>
      <input id={inputId} type="email" name={SUBSCRIBE_FIELD} placeholder="you@email.com" required autocomplete="email" />
      <button type="submit">Subscribe</button>
    </form>
  </div>
</section>

<script>
  // Without a newsletter service, a sign up opens an email to Ankit instead.
  document.querySelectorAll<HTMLFormElement>('form.sub-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const button = form.querySelector('button');
      const to = form.dataset.fallback;
      if (to) {
        e.preventDefault();
        const email = (form.querySelector('input') as HTMLInputElement).value;
        location.href = `mailto:${to}?subject=${encodeURIComponent('Subscribe me')}&body=${encodeURIComponent('Please add ' + email + ' to the Curious Ankit list.')}`;
      }
      if (button) button.textContent = 'Thanks!';
    });
  });
</script>

<style>
  .subscribe.dark {
    background: var(--ink);
    color: #fff;
  }
  .subscribe.light {
    background: var(--grey-bg);
    color: var(--ink);
  }
  .inner {
    max-width: 688px;
    padding-top: clamp(72px, 9vw, 112px);
    padding-bottom: clamp(72px, 9vw, 112px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  h2 {
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .text {
    font-size: 18px;
    line-height: 1.55;
  }
  .dark .text {
    color: #d4d4d8;
  }
  .light .text {
    color: var(--muted);
  }
  form {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  input {
    flex: 1 1 220px;
    min-height: 50px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 16px;
  }
  .dark input {
    border: 1px solid #52525b;
    background: #27272a;
    color: #fff;
  }
  .dark input::placeholder {
    color: #a1a1aa;
  }
  .light input {
    border: 1px solid #d4d4d8;
    background: #fff;
    color: var(--ink);
  }
  button {
    min-height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    border: 0;
    font-weight: 600;
    font-size: 16px;
  }
  .dark button {
    background: #fff;
    color: var(--ink);
  }
  .light button {
    background: var(--ink);
    color: #fff;
  }
  .dark :focus-visible {
    outline-color: #fff;
  }
</style>
