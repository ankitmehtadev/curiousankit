---
// The Lens wordmark: stacked "Curious / Ankit", the o in Curious drawn as a magnifying glass
// in the accent colour. Sized in px via the size prop.
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<span class="logo" style={`font-size:${size}px`}>
  <span>Curi<svg class="lens" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="2.8"></circle><line x1="14.8" y1="14.8" x2="20.5" y2="20.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"></line></svg><span class="sr-only">o</span>us</span>
  <span>Ankit</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .lens {
    display: inline-block;
    width: 0.64em;
    height: 0.64em;
    vertical-align: -0.03em;
    margin: 0 0.01em;
    color: var(--accent);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(a:hover) > .logo .lens {
    transform: rotate(-15deg) scale(1.06);
  }
</style>
