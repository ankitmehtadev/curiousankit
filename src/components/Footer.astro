---
import { LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <a class="mark" href="/" aria-label="Curious Ankit, home">Curious <em>Ankit</em></a>
    <nav aria-label="Footer">
      <a href="/about">About</a>
      <a href="/rss.xml">RSS</a>
      {
        LINKS.linkedin && (
          <a href={LINKS.linkedin} target="_blank" rel="noopener">
            LinkedIn
          </a>
        )
      }
      <a href={LINKS.home} target="_blank" rel="noopener">ank1t.com</a>
    </nav>
    <p class="copy">&copy; {year} Ankit</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--ink);
    padding: 1.6rem 0 2rem;
    font-size: 0.78rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .mark {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    justify-self: start;
  }
  .mark em {
    font-weight: 500;
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 1.3rem;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover {
    color: var(--ink);
  }
  .copy {
    margin: 0;
    justify-self: end;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .copy {
      justify-self: start;
    }
  }
</style>
