---
import { AUTHOR, LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <span>&copy; {year} {AUTHOR.name} · curiousankit.com</span>
    <span class="links">
      <a href="/shelf/">Shelf</a>
      <a href={LINKS.linkedin}>LinkedIn</a>
      <a href={LINKS.github}>GitHub</a>
      <a href="/rss.xml">RSS</a>
      <a href={`mailto:${LINKS.email}`}>Email</a>
    </span>
  </div>
</footer>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-top: 28px;
    padding-bottom: 28px;
    font-size: 13px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--ink);
  }
</style>
