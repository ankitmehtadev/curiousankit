---
// A callout for the one thing readers should remember.
//   <KeyIdea>The one thing to remember.</KeyIdea>
//   <KeyIdea label="Huh, interesting">A surprising fact.</KeyIdea>
// (variant is kept for older posts and looks the same either way.)
interface Props {
  label?: string;
  variant?: 'solid' | 'outline';
}
const { label = 'Key idea', variant = 'solid' } = Astro.props;
---

<aside class:list={['key-idea', variant]}>
  <div class="ki-label">{label}</div>
  <div class="ki-text"><slot /></div>
</aside>

<style>
  .key-idea {
    margin: 40px 0;
    padding: 32px 36px;
    border-radius: 24px;
    background: var(--grey-bg);
  }
  .ki-label {
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .ki-text {
    font-family: var(--display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ki-text :global(p) {
    margin: 0;
  }
  .ki-text :global(p + p) {
    margin-top: 12px;
  }
  @media (max-width: 640px) {
    .key-idea {
      margin: 28px 0;
      padding: 22px;
    }
    .ki-text {
      font-size: 19px;
    }
  }
</style>
