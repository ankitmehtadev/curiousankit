---
// A result, drawn so it still reads in pure black and white:
// filled = worked, half = mixed, empty = did not work, dashed = in progress.
interface Props {
  outcome: 'Worked' | 'Mixed' | 'Did not work' | 'In progress';
}

const { outcome } = Astro.props;
---

<span class="mark">
  <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
    {outcome === 'Worked' && <circle cx="7" cy="7" r="5.6" fill="currentColor" />}
    {
      outcome === 'Mixed' && (
        <>
          <circle cx="7" cy="7" r="5.6" />
          <path d="M7 1.4A5.6 5.6 0 0 0 7 12.6Z" fill="currentColor" stroke="none" />
        </>
      )
    }
    {outcome === 'Did not work' && <circle cx="7" cy="7" r="5.6" />}
    {outcome === 'In progress' && <circle cx="7" cy="7" r="5.6" stroke-dasharray="2.2 2.1" />}
  </svg>
  <span>{outcome}</span>
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  svg {
    flex: none;
  }
</style>
