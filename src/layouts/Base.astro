---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  // Hide the site footer (used by the one screen About page).
  footer?: boolean;
}

const { title, description, image, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <slot name="top" />
    <Header />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    width: auto;
    height: auto;
    padding: 10px 14px;
    margin: 0;
    clip: auto;
    background: var(--red);
    color: var(--white);
  }
</style>
