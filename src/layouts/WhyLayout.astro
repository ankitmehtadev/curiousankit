---
// Everyday Why: a short story behind an everyday thing.
import Base from './Base.astro';
import Subscribe from '../components/Subscribe.astro';
import PostScripts from '../components/post/PostScripts.astro';
import { SITE_TITLE, WHYS } from '../consts';
import { formatDate, isoDate, kickerOf, postUrl, readingTime, type Post } from '../utils';
import '../styles/prose.css';

interface Props {
  post: Post;
  previous?: Post;
}

const { post, previous } = Astro.props;
const d = post.data;
const minutes = readingTime(post.body);
---

<Base title={`${d.title} | ${SITE_TITLE}`} description={d.description} image={`/og/everyday-whys/${post.id}.png`}>
  <article>
    <header class="wrap narrow hero">
      <a class="kicker" href={WHYS.href}>{kickerOf(post)}</a>
      <h1 class="title">{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="meta"><time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time> · {minutes} min read</p>
    </header>

    <div class="wrap read">
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      d.payoff && (
        <div class="wrap narrow block">
          <aside class="panel payoff" aria-label="The payoff">
            <p class="kicker">The payoff</p>
            <p class="payoff-text">{d.payoff}</p>
          </aside>
        </div>
      )
    }

    {(d.myth || d.sources.length > 0) && (
    <div class="wrap read extras">
      {
        d.myth && (
          <div class="extra">
            <p class="meta">Myth or true?</p>
            <p class="extra-text">{d.myth}</p>
          </div>
        )
      }
      {
        d.sources.length > 0 && (
          <div class="extra sources">
            <p class="meta">Sources</p>
            <ul>
              {d.sources.map((s) => (
                <li>{s.url ? <a href={s.url}>{s.label}</a> : s.label}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    )}
  </article>

  <nav class="wrap read more-nav" aria-label="More Everyday Whys">
    {
      previous && (
        <a class="prev" href={postUrl(previous)}>
          <span class="meta">‹ Last week</span>
          <span class="prev-title">{previous.data.title}</span>
        </a>
      )
    }
    <a class="more" href={WHYS.href}>All Everyday Whys ›</a>
  </nav>

  <Subscribe title="Get next week's Why." text="One short story in your inbox. No spam." />
  <PostScripts />
</Base>

<style>
  .title {
    font-size: clamp(42px, 6.5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .lede {
    max-width: 620px;
    font-size: clamp(19px, 2.2vw, 22px);
  }
  .block {
    padding-top: 48px;
  }
  .payoff {
    padding: clamp(40px, 6vw, 64px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .payoff-text {
    max-width: 620px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .extras {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .extra {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .extra-text {
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
  }
  .sources {
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .sources ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--body);
  }
  .sources a {
    color: var(--ink);
  }
  .more-nav {
    padding-top: 72px;
    padding-bottom: clamp(72px, 9vw, 112px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .prev {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }
  .prev-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.015em;
  }
  .prev:hover .prev-title {
    color: var(--accent-text);
  }
</style>
