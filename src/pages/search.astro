---
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';
---

<Base title={`Search | ${SITE_TITLE}`} description="Search the notes.">
  <section class="wrap page">
    <h1>Search</h1>
    <label class="sr-only" for="q">Search the notes</label>
    <input id="q" type="search" placeholder="Search notes, experiments and learning" autocomplete="off" />
    <p id="status" class="status" aria-live="polite"></p>
    <ul id="results" class="results"></ul>
  </section>
</Base>

<script>
  type Entry = {
    title: string;
    description: string;
    category: string;
    tags: string[];
    date: string;
    url: string;
    text: string;
  };

  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status') as HTMLElement;
  const results = document.getElementById('results') as HTMLUListElement;
  let entries: Entry[] = [];

  function render(query: string) {
    results.replaceChildren();
    const q = query.trim().toLowerCase();
    if (!q) {
      status.textContent = '';
      return;
    }
    const terms = q.split(/\s+/);
    const hits = entries.filter((e) => {
      const hay = `${e.title} ${e.description} ${e.category} ${e.tags.join(' ')} ${e.text}`.toLowerCase();
      return terms.every((t) => hay.includes(t));
    });
    status.textContent = hits.length === 0 ? 'Nothing found. Try a shorter or different word.' : `${hits.length} found`;
    for (const hit of hits) {
      const li = document.createElement('li');
      const meta = document.createElement('p');
      meta.className = 'meta';
      const date = new Date(hit.date).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
      meta.textContent = `${date} · ${hit.category}`;
      const a = document.createElement('a');
      a.href = hit.url;
      a.textContent = hit.title;
      a.className = 'title';
      const p = document.createElement('p');
      p.className = 'desc';
      p.textContent = hit.description;
      li.append(meta, a, p);
      results.append(li);
    }
  }

  fetch('/search.json')
    .then((r) => r.json())
    .then((data: Entry[]) => {
      entries = data;
      const initial = new URLSearchParams(location.search).get('q');
      if (initial) input.value = initial;
      render(input.value);
    })
    .catch(() => {
      status.textContent = 'Search is not available right now.';
    });

  input.addEventListener('input', () => render(input.value));
  input.focus();
</script>

<style>
  .page {
    padding-top: 4rem;
  }
  h1 {
    margin-bottom: 1.2rem;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }
  input {
    width: 100%;
    max-width: 34rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-size: 0.95rem;
    background: var(--paper);
    color: var(--ink);
  }
  .status {
    min-height: 1.5rem;
    margin: 0.8rem 0 1.4rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .results {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results :global(li) {
    padding: 1.2rem 0;
    border-top: 1px solid var(--rule);
  }
  .results :global(.meta) {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .results :global(.title) {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    text-decoration: none;
  }
  .results :global(.title:hover) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .results :global(.desc) {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
  }
</style>
