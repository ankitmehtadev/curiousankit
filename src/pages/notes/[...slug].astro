---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { sortNotes } from '../../utils';

export async function getStaticPaths() {
  const notes = sortNotes(await getCollection('blog'));
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}

type Props = {
  note: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
};

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---

<BlogPost note={note} newer={newer} older={older}>
  <Content />
</BlogPost>
