---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { DIVES, HOME_INTRO, SITE_DESCRIPTION, SITE_TITLE, TAGLINE, WHYS } from '../consts';
import { getDives, getWhys, postUrl, readingTime, weekOf } from '../utils';

const [whys, dives] = await Promise.all([getWhys(), getDives()]);
const latestWhy = whys[0];
const earlierWhys = whys.slice(1, 4);
const recentDives = dives.slice(0, 3);

// The main button points at the newest thing worth reading.
const primary = latestWhy
  ? { label: "Read this week's Why", href: postUrl(latestWhy) }
  : dives[0]
    ? { label: 'Read the latest Deep Dive', href: postUrl(dives[0]) }
    : undefined;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="wrap intro">
    <h1>{TAGLINE}.</h1>
    <p class="lede">{HOME_INTRO}</p>
    <div class="actions">
      {primary && <a class="btn" href={primary.href}>{primary.label}</a>}
      <a class="btn-outline" href="#subscribe">Subscribe</a>
    </div>
  </section>

  {
    latestWhy && (
      <section class="this-week" aria-labelledby="this-week">
        <a class="wrap narrow tw-inner" href={postUrl(latestWhy)}>
          <p id="this-week" class="kicker">This week's Everyday Why</p>
          <h2>{latestWhy.data.title}</h2>
          <p class="lede">{latestWhy.data.description}</p>
          <span class="more">Read the story ›</span>
        </a>
      </section>
    )
  }

  {
    recentDives.length > 0 && (
      <section class="wrap narrow block" aria-labelledby="deep-dives">
        <div class="block-head">
          <h2 id="deep-dives">{DIVES.label}</h2>
          <p>{DIVES.short}</p>
        </div>
        <div class="rows">
          {recentDives.map((p) => (
            <a class="row" href={postUrl(p)}>
              <span class="row-title">{p.data.title}</span>
              <span class="meta">
                {p.data.topic ? `${p.data.topic} · ` : ''}
                {readingTime(p.body)} min
              </span>
            </a>
          ))}
        </div>
        <a class="more center" href={DIVES.href}>All {DIVES.label} ›</a>
      </section>
    )
  }

  {
    recentDives.length === 0 && earlierWhys.length > 0 && (
      <section class="wrap narrow block" aria-labelledby="earlier">
        <div class="block-head">
          <h2 id="earlier">Earlier Whys</h2>
        </div>
        <div class="rows">
          {earlierWhys.map((p) => (
            <a class="row" href={postUrl(p)}>
              <span class="row-title">{p.data.title}</span>
              <span class="meta">Week {weekOf(p)}</span>
            </a>
          ))}
        </div>
        <a class="more center" href={WHYS.href}>All {WHYS.label} ›</a>
      </section>
    )
  }

  <Subscribe />
</Base>

<style>
  .intro {
    max-width: 1000px;
    padding-top: clamp(88px, 12vw, 136px);
    padding-bottom: clamp(88px, 12vw, 144px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }
  .intro h1 {
    font-size: clamp(46px, 8vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .lede {
    max-width: 600px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .this-week {
    background: var(--grey-bg);
  }
  .tw-inner {
    padding-top: clamp(80px, 10vw, 120px);
    padding-bottom: clamp(80px, 10vw, 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    text-decoration: none;
    color: var(--ink);
  }
  .tw-inner h2 {
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .block {
    padding-top: clamp(80px, 10vw, 112px);
    padding-bottom: clamp(80px, 10vw, 112px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .block-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .block-head h2 {
    font-size: clamp(34px, 4.5vw, 44px);
    letter-spacing: -0.035em;
  }
  .block-head p {
    font-size: 18px;
    color: var(--muted);
  }
  .center {
    align-self: center;
  }
</style>
