---
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';
import { LEARNING, type LearningItem } from '../data/learning';

const studying = LEARNING.filter((i) => i.status === 'studying');
const next = LEARNING.filter((i) => i.status === 'next');
const finished = LEARNING.filter((i) => i.status === 'finished');

// The top block is the first item in progress. With none in progress, the latest finished one.
const heroIsFinished = studying.length === 0 && finished.length > 0;
const hero: LearningItem | undefined = studying[0] ?? finished[0];
const others = studying.slice(1);
const finishedList = heroIsFinished ? finished.slice(1) : finished;
const hasBand = next.length > 0 || finishedList.length > 0;

const intro = 'Courses and books I work through, and what I take from each.';

const heroLabel = hero
  ? heroIsFinished
    ? 'Most recently finished'
    : hero.kind === 'Book'
      ? 'Reading now'
      : hero.kind === 'Video'
        ? 'Watching now'
        : 'Studying now'
  : '';
const mixedKinds = new Set(others.map((o) => o.kind)).size > 1;
const alsoLabel = mixedKinds
  ? 'Also in progress'
  : others[0]?.kind === 'Book'
    ? 'Also reading'
    : others[0]?.kind === 'Video'
      ? 'Also watching'
      : 'Also studying';

const progressText = (i: LearningItem) =>
  i.progress
    ? `${i.progress.done} of ${i.progress.total} ${i.progress.unit}s ${i.kind === 'Book' ? 'read' : i.kind === 'Video' ? 'watched' : 'complete'}`
    : '';
const percent = (i: LearningItem) =>
  i.progress ? Math.min(100, Math.round((i.progress.done / i.progress.total) * 100)) : 0;
---

<Base title={`Learning | ${SITE_TITLE}`} description={intro}>
  <section class="wrap top">
    <h1>Learning</h1>
    <p class="intro">{intro}</p>

    {LEARNING.length === 0 && <p class="empty">The first entry is on its way.</p>}

    {
      hero && (
        <div class:list={['focus', { solo: others.length === 0 }]}>
          <div class="main">
            <p class="label">{heroLabel}</p>
            <h2>
              {hero.url ? (
                <a href={hero.url} target="_blank" rel="noopener">{hero.title}<span class="sr-only"> (opens in a new tab)</span></a>
              ) : (
                hero.title
              )}
            </h2>
            <p class="by">
              {hero.byUrl ? <a href={hero.byUrl} target="_blank" rel="noopener">{hero.by}</a> : hero.by} &middot; {hero.kind}
            </p>

            {
              hero.progress && (
                <div class="progress">
                  <div class="track" role="img" aria-label={progressText(hero)}>
                    <div class="fill" style={`width:${percent(hero)}%`}></div>
                  </div>
                  <div class="progress-text">
                    <span>{progressText(hero)}</span>
                    <span>{hero.started ? `Started ${hero.started}` : ''}</span>
                  </div>
                </div>
              )
            }
            {!hero.progress && hero.started && <p class="started">Started {hero.started}</p>}
            {heroIsFinished && hero.finished && <p class="started">Finished {hero.finished}</p>}

            {
              hero.takeaway && (
                <div class="stands">
                  <p class="label">{heroIsFinished ? 'What I took from it' : 'What stands out so far'}</p>
                  <p class="quote">{hero.takeaway}</p>
                  {hero.notes && <a class="more" href={hero.notes}>{heroIsFinished ? 'Read my notes' : 'Notes so far'}</a>}
                </div>
              )
            }
            {!hero.takeaway && hero.notes && <p class="stands"><a class="more" href={hero.notes}>Read my notes</a></p>}
          </div>

          {
            others.length > 0 && (
              <aside class="also">
                <p class="label">{alsoLabel}</p>
                {others.map((o) => (
                  <div class="other">
                    <h3>
                      {o.url ? (
                        <a href={o.url} target="_blank" rel="noopener">{o.title}<span class="sr-only"> (opens in a new tab)</span></a>
                      ) : (
                        o.title
                      )}
                    </h3>
                    <p class="by">
                      {o.byUrl ? <a href={o.byUrl} target="_blank" rel="noopener">{o.by}</a> : o.by} &middot; {o.kind}
                    </p>
                    {
                      o.progress && (
                        <div class="progress">
                          <div class="track" role="img" aria-label={progressText(o)}>
                            <div class="fill" style={`width:${percent(o)}%`}></div>
                          </div>
                          <div class="progress-text"><span>{progressText(o)}</span></div>
                        </div>
                      )
                    }
                  </div>
                ))}
              </aside>
            )
          }
        </div>
      )
    }
  </section>

  {
    hasBand && (
      <section class="band">
        <div class:list={['wrap', 'cols', { both: next.length > 0 && finishedList.length > 0 }]}>
          {
            next.length > 0 && (
              <div class="col">
                <h2>Up next</h2>
                <ul>
                  {next.map((n) => (
                    <li>
                      <h3>
                        {n.url ? (
                          <a href={n.url} target="_blank" rel="noopener">{n.title}<span class="sr-only"> (opens in a new tab)</span></a>
                        ) : (
                          n.title
                        )}
                      </h3>
                      <p class="by">
                        {n.byUrl ? <a href={n.byUrl} target="_blank" rel="noopener">{n.by}</a> : n.by} &middot; {n.kind}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            finishedList.length > 0 && (
              <div class="col">
                <h2>Finished</h2>
                <ul>
                  {finishedList.map((f) => (
                    <li>
                      <h3>
                        {f.url ? (
                          <a href={f.url} target="_blank" rel="noopener">{f.title}<span class="sr-only"> (opens in a new tab)</span></a>
                        ) : (
                          f.title
                        )}
                      </h3>
                      <p class="by">
                        {f.byUrl ? <a href={f.byUrl} target="_blank" rel="noopener">{f.by}</a> : f.by} &middot; {f.kind}
                        {f.finished && <span> &middot; Finished {f.finished}</span>}
                      </p>
                      {f.takeaway && <p class="took">{f.takeaway}</p>}
                      {f.notes && <a class="more" href={f.notes}>Read my notes</a>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>
    )
  }
</Base>

<style>
  .top {
    padding-top: 4rem;
  }
  h1 {
    margin-bottom: 0.4em;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }
  .intro {
    max-width: 34rem;
    margin: 0 0 3.5rem;
    color: var(--muted);
  }
  .empty {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-style: italic;
  }
  .label {
    margin: 0 0 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  a {
    text-underline-offset: 0.18em;
  }

  /* The block at the top */
  .focus {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    column-gap: 4.5rem;
    align-items: start;
  }
  .focus.solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .main h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(2.2rem, 4.4vw, 3.5rem);
    line-height: 1.06;
  }
  .main h2 a,
  .other h3 a,
  .col h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .main h2 a:hover,
  .other h3 a:hover,
  .col h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .by {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .by a {
    color: var(--muted);
  }
  .progress {
    margin-top: 1.4rem;
  }
  .track {
    height: 2px;
    background: var(--rule);
  }
  .fill {
    height: 2px;
    background: var(--ink);
  }
  .progress-text {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .started {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .stands {
    margin: 2rem 0 0;
  }
  .quote {
    max-width: 36rem;
    margin: 0 0 0.6rem;
    font-family: var(--font-title);
    font-size: 1.6rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }
  .more {
    font-size: 0.85rem;
  }
  .also {
    padding-top: 1.2rem;
    border-top: 1px solid var(--ink);
  }
  .other + .other {
    margin-top: 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .other h3 {
    margin-bottom: 0.4rem;
    font-size: 1.9rem;
  }

  /* The grey band: up next and finished */
  .band {
    margin-top: 5rem;
    padding: 3.4rem 0 4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--band);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .cols:not(.both) .col {
    max-width: 40rem;
  }
  .cols.both {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    column-gap: 4.5rem;
  }
  .col h2 {
    margin: 0 0 0.9rem;
    font-size: 1.9rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  li {
    padding: 1.2rem 0 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .col h3 {
    margin: 0 0 0.3rem;
    font-size: 1.5rem;
  }
  .took {
    margin: 0.8rem 0 0.5rem;
    font-family: var(--font-title);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .top {
      padding-top: 3rem;
    }
    .focus,
    .cols.both {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.4rem;
    }
    .intro {
      margin-bottom: 2.4rem;
    }
    .quote {
      font-size: 1.35rem;
    }
  }
</style>
