---
import Base from '../../layouts/Base.astro';
import { DIVES, SITE_TITLE } from '../../consts';
import { formatDate, getDives, kickerOf, postUrl, readingTime } from '../../utils';

const dives = await getDives();
const topics = Array.from(new Set(dives.map((p) => p.data.topic).filter(Boolean))).sort();
---

<Base title={`${DIVES.label} | ${SITE_TITLE}`} description={DIVES.blurb}>
  <section class="wrap narrow hero">
    <h1>{DIVES.label}</h1>
    <p class="lede">{DIVES.blurb}</p>
  </section>

  <section class="wrap narrow list" aria-label={`All ${DIVES.label}`}>
    {
      topics.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by topic" data-filters hidden>
          <button type="button" class="chip" aria-pressed="true" data-topic="All">
            All
          </button>
          {topics.map((t) => (
            <button type="button" class="chip" aria-pressed="false" data-topic={t}>
              {t}
            </button>
          ))}
        </div>
      )
    }

    {
      dives.length === 0 ? (
        <p class="empty">The first one is on its way.</p>
      ) : (
        <div class="rows">
          {dives.map((p) => (
            <a class="row dive" href={postUrl(p)} data-topic={p.data.topic}>
              <span class="meta">
                {kickerOf(p).replace(/^Deep Dive · /, '')} · {formatDate(p.data.pubDate)} · {readingTime(p.body)} min read
              </span>
              <span class="dive-title">{p.data.title}</span>
              <span class="dive-desc">{p.data.description}</span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  if (group) {
    group.hidden = false;
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button[data-topic]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.dive[data-topic]'));
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const t = b.dataset.topic;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        rows.forEach((r) => (r.hidden = !(t === 'All' || r.dataset.topic === t)));
      }),
    );
  }
</script>

<style>
  .list {
    padding-bottom: clamp(72px, 9vw, 112px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .filters[hidden],
  .dive[hidden] {
    display: none;
  }
  .dive {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 30px 0;
  }
  .dive-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(22px, 2.8vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .dive:hover .dive-title {
    color: var(--accent-text);
  }
  .dive-desc {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }
  .empty {
    text-align: center;
    font-size: 18px;
    color: var(--muted);
  }
</style>
