---
import Subscribe from '../components/Subscribe.astro';
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';

const feed = new URL('/rss.xml', Astro.site).href;
const intro = "The week's Everyday Why in your inbox, and Deep Dives when they're ready.";
---

<Base title={`Subscribe | ${SITE_TITLE}`} description={intro}>
  <section class="wrap narrow hero">
    <h1>Never miss a why.</h1>
    <p class="lede">{intro}</p>
  </section>

  <Subscribe id="email" variant="light" title="By email" text="One short story, every week. No spam." />

  <section class="wrap narrow rss" aria-labelledby="rss-title">
    <h2 id="rss-title">Prefer a feed reader?</h2>
    <p>
      RSS is a plain, ad free way to follow a website. Paste this address into a feed reader, such as
      Feedly, Inoreader or NetNewsWire, and new posts arrive there by themselves. No account, nothing to
      sign up for.
    </p>
    <div class="address">
      <code id="feed">{feed}</code>
      <button type="button" id="copy" class="btn-outline">Copy address</button>
    </div>
  </section>
</Base>

<script>
  const button = document.getElementById('copy') as HTMLButtonElement | null;
  const feed = document.getElementById('feed');
  button?.addEventListener('click', async () => {
    let label = 'Copied';
    try {
      await navigator.clipboard.writeText(feed?.textContent ?? '');
    } catch {
      if (feed) {
        const range = document.createRange();
        range.selectNodeContents(feed);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      label = 'Selected, copy it';
    }
    button.textContent = label;
    window.setTimeout(() => (button.textContent = 'Copy address'), 2000);
  });
</script>

<style>
  .rss {
    padding-top: clamp(72px, 9vw, 104px);
    padding-bottom: clamp(72px, 9vw, 112px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  .rss h2 {
    font-size: clamp(30px, 4vw, 40px);
    letter-spacing: -0.035em;
  }
  .rss p {
    max-width: 600px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
  }
  .address {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  code {
    font-family: var(--mono);
    font-size: 14px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--grey-bg);
  }
</style>
