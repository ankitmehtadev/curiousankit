---
import { Image } from 'astro:assets';
import portrait from '../assets/ankit.jpg';
import Base from '../layouts/Base.astro';
import { LINKS, SITE_TITLE } from '../consts';
---

<Base title={`About | ${SITE_TITLE}`} description="Who is behind Curious Ankit, and why these notes exist.">
  <section class="wrap about">
    <h1>About</h1>

    <figure class="portrait">
      <Image
        src={portrait}
        alt="Portrait of Ankit Mehta"
        width={640}
        widths={[320, 480, 640]}
        sizes="(max-width: 760px) 14rem, 20rem"
        loading="eager"
      />
    </figure>

    <div class="prose">
      <p>
        I am Ankit, a business analyst based in Melbourne. For more than twelve years I have worked
        on digital transformation, procurement and software delivery, and I teach business analysis
        and Agile delivery to postgraduate students at Monash University.
      </p>
      <p>
        This site is my notebook for learning AI in the open. It holds the experiments I run, the
        courses I take, the things that worked and the things that did not. It is not a polished
        portfolio. It is a record of me getting better at something, and I hope it is useful to
        anyone a few steps behind me or alongside me.
      </p>
      <p>
        The site itself is built with Astro and written, in part, with the help of AI, which seems
        the right way to document it.
      </p>
      <p class="elsewhere">
        <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(12rem, 27vw, 20rem);
    grid-template-areas:
      'title photo'
      'prose photo';
    column-gap: 4rem;
    align-items: start;
    padding-top: 4rem;
  }
  h1 {
    grid-area: title;
    margin-bottom: 1.2rem;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }
  .prose {
    grid-area: prose;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2.4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
  }

  /* The portrait: greyscale, fading into the page at the bottom,
     and it takes on its true colour when pointed at. */
  .portrait {
    grid-area: photo;
    margin: 0.7rem 0 0;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    filter: grayscale(1) contrast(1.05);
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    transition: filter 0.5s ease;
  }
  .portrait :global(img:hover) {
    filter: grayscale(0) contrast(1.02);
  }
  :global(:root[data-theme='dark']) .portrait :global(img) {
    filter: grayscale(1) brightness(0.82) contrast(1.05);
  }
  :global(:root[data-theme='dark']) .portrait :global(img:hover) {
    filter: grayscale(0) brightness(0.9) contrast(1.02);
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'title'
        'photo'
        'prose';
      padding-top: 3rem;
    }
    .portrait {
      width: 14rem;
      margin: 0.2rem 0 1.8rem;
    }
  }
</style>
