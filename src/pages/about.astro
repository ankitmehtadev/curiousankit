---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/ankit.jpg';
import { ABOUT, DIVES, LINKS, SITE_TITLE, WHYS } from '../consts';
---

<Base title={`About | ${SITE_TITLE}`} description={ABOUT.heading}>
  <section class="wrap about">
    <div class="photo">
      <Image
        src={photo}
        alt="Ankit, smiling, in glasses and a grey polo shirt"
        widths={[400, 600, 800]}
        sizes="(max-width: 760px) 90vw, 400px"
        loading="eager"
      />
    </div>
    <div class="text">
      <h1>{ABOUT.heading}</h1>
      <p class="bio">{ABOUT.bio}</p>
      {ABOUT.currently.length > 0 && <p class="meta">Currently: {ABOUT.currently.join(' · ')}</p>}
      <div class="tiles">
        <a class="tile" href={WHYS.href}>
          <span class="tile-title">{WHYS.label} ›</span>
          <span class="tile-text">The story behind an everyday thing, every week.</span>
        </a>
        <a class="tile" href={DIVES.href}>
          <span class="tile-title">{DIVES.label} ›</span>
          <span class="tile-text">Longer reads on AI, money, history and more.</span>
        </a>
      </div>
      <div class="actions">
        <a class="btn" href={LINKS.linkedin}>Connect on LinkedIn</a>
        <a class="btn-outline" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
        <a class="more" href="/shelf/">My Shelf ›</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    min-height: calc(100vh - 140px);
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 6vw, 72px);
  }
  .photo {
    flex: 1 1 300px;
    max-width: 400px;
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
    filter: grayscale(1) contrast(1.08);
  }
  .text {
    flex: 999 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: clamp(40px, 5.6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .bio {
    max-width: 560px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    max-width: 600px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    border-radius: 18px;
    background: var(--grey-bg);
    text-decoration: none;
    color: var(--ink);
  }
  .tile-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
  }
  .tile:hover .tile-title {
    color: var(--accent-text);
  }
  .tile-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .actions .more {
    padding: 12px 8px;
  }
</style>
