---
import Avatar from '../components/Avatar.astro';
import Base from '../layouts/Base.astro';
import { LINKS, SITE_TITLE } from '../consts';

// Quick questions and Ankit's answers. Edit freely; bracketed lines are placeholders to fill in.
const qa = [
  { q: 'Best way to reach you?', a: `Email ${LINKS.email}, or use the box below. I read everything.` },
  { q: 'Can I suggest a rabbit hole?', a: 'Please do. The best topics come from other curious people. Send it my way and I might write about it.' },
  { q: 'Want to compare AI notes?', a: 'Always. If you’re experimenting with AI too, I’d love to hear what’s working for you.' },
  { q: 'Do you mentor?', a: 'Yes. I mentor postgraduate students at Monash University, and outside of that I mentor my ex students and other professionals in the industry. Drop me a line.' },
  { q: 'Where else can I find you?', a: 'ank1t.com for my personal site, GitHub for experiments, and LinkedIn for the work side of things.' },
  { q: 'How fast do you reply?', a: 'Within 48 business hours. Rabbit hole suggestions sometimes get a faster reply.' },
];
const greeting = 'Hey there. Got a question, an idea or a rabbit hole to share? Start here.';
const subject = 'Hello from curiousankit.com';
const mailto = `mailto:${LINKS.email}?subject=${encodeURIComponent(subject)}`;
---

<Base title={`Contact | ${SITE_TITLE}`} description="Ask me anything. Tap a question for a quick answer, or write me a proper message.">
  <div class="wrap">
    <section class="contact">
      <div class="left">
        <div>
          <div class="mono small desk-only">Contact</div>
          <h1>Ask me <span class="red">anything.</span></h1>
          <p class="lede">
            Tap a question for a quick answer, or write me a proper message.<span class="desk-only"> Either way, I read everything.</span>
          </p>
        </div>
        <div class="card desk-only">
          <div class="wave"><Avatar id="contact" sparkles={1} /></div>
          <div class="who mono">
            <div class="name">Ankit</div>
            <div class="muted">Technologist · Melbourne</div>
            <div class="status"><span class="live"></span>Usually replies with too much detail</div>
            <div class="elsewhere">
              <a href={LINKS.home}>ank1t.com</a>
              <a href={LINKS.github}>GitHub</a>
              {LINKS.linkedin && <a href={LINKS.linkedin}>LinkedIn</a>}
            </div>
          </div>
        </div>
      </div>

      <div class="right">
        <div class="chat-head mono desk-flex">
          <span>Chat with Ankit</span>
          <button type="button" class="reset">Start over ↺</button>
        </div>
        <div class="chat-head-m mob-flex">
          <span class="mini" aria-hidden="true">A</span>
          <div class="mono">
            <div class="name-s">Ankit</div>
            <div class="muted-s">Usually replies with too much detail</div>
          </div>
          <button type="button" class="reset mono">↺</button>
        </div>

        <div class="log" aria-live="polite">
          <div class="msg me">
            <span class="by mono">Ankit</span>
            <div class="bubble">{greeting}</div>
          </div>
        </div>

        <div class="chips-wrap">
          <div class="swipe mono mob-only">Tap a question · swipe →</div>
          <div class="chips" role="group" aria-label="Questions to ask">
            {qa.map((x, i) => <button type="button" class="ask" data-i={i}>{x.q}</button>)}
          </div>
        </div>

        <div class="write">
          <label for="msg" class="mono">Or write your own message</label>
          <div class="write-row">
            <textarea id="msg" rows="2" placeholder="Hi Ankit, I was curious about…"></textarea>
            <a href={mailto} class="send">Send <span aria-hidden="true">→</span></a>
          </div>
          <span class="mono note"><span class="desk-only">Opens your email app, addressed to {LINKS.email}</span><span class="mob-only">Opens your email app</span></span>
        </div>
      </div>
    </section>
  </div>
  <script type="application/json" id="qa" set:html={JSON.stringify({ qa, greeting, mailto })}></script>
</Base>

<script>
  type QA = { q: string; a: string };
  const data = JSON.parse(document.getElementById('qa')?.textContent || '{}') as { qa: QA[]; greeting: string; mailto: string };
  const log = document.querySelector<HTMLElement>('.log');
  const chips = document.querySelectorAll<HTMLButtonElement>('.ask');
  let timer: number | undefined;
  let typing = false;

  function addMsg(text: string, me: boolean) {
    if (!log) return;
    const wrap = document.createElement('div');
    wrap.className = `msg ${me ? 'me' : 'you'}`;
    const by = document.createElement('span');
    by.className = 'by mono';
    by.textContent = me ? 'Ankit' : 'You';
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.textContent = text;
    wrap.append(by, bubble);
    log.append(wrap);
    log.scrollTop = log.scrollHeight;
  }

  function showTyping(on: boolean) {
    typing = on;
    chips.forEach((c) => (c.disabled = on));
    log?.querySelector('.typing')?.remove();
    if (on && log) {
      const dots = document.createElement('div');
      dots.className = 'typing';
      dots.setAttribute('aria-label', 'Ankit is typing');
      dots.innerHTML = '<span class="d1">•</span><span class="d2">•</span><span class="d3">•</span>';
      log.append(dots);
      log.scrollTop = log.scrollHeight;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      if (typing) return;
      const item = data.qa[Number(chip.dataset.i)];
      chip.hidden = true;
      addMsg(item.q, false);
      showTyping(true);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        showTyping(false);
        addMsg(item.a, true);
      }, 900);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.reset').forEach((btn) =>
    btn.addEventListener('click', () => {
      window.clearTimeout(timer);
      showTyping(false);
      if (log) log.innerHTML = '';
      addMsg(data.greeting, true);
      chips.forEach((c) => (c.hidden = false));
    }),
  );

  const textarea = document.querySelector<HTMLTextAreaElement>('#msg');
  const send = document.querySelector<HTMLAnchorElement>('.send');
  textarea?.addEventListener('input', () => {
    if (send) send.href = `${data.mailto}&body=${encodeURIComponent(textarea.value)}`;
  });
</script>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 0;
    border-top: 1px solid var(--white);
    min-height: calc(100vh - 230px);
  }
  .small {
    font-size: 13px;
    color: var(--smoke);
    margin-bottom: 16px;
  }
  .left {
    flex: 2 1 400px;
    padding: 32px 40px 32px 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  h1 {
    font-size: clamp(56px, 6vw, 100px);
    line-height: 0.86;
    letter-spacing: -0.055em;
  }
  .lede {
    margin-top: 20px;
    max-width: 400px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted);
  }
  .card {
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }
  .wave {
    flex: 0 0 auto;
    width: clamp(160px, 14vw, 230px);
    transform-origin: 50% 90%;
    animation: wave 3s ease-in-out infinite;
  }
  @keyframes wave {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-6deg);
    }
    75% {
      transform: rotate(5deg);
    }
  }
  .who {
    font-size: 13px;
    line-height: 1.6;
    padding-bottom: 8px;
  }
  .name {
    font-family: var(--font);
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  .muted {
    color: var(--muted);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--smoke);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }
  .elsewhere {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .elsewhere a {
    text-decoration: none;
  }
  .elsewhere a:hover {
    color: var(--red);
  }

  /* Chat */
  .right {
    flex: 3 1 520px;
    min-width: 0;
    padding: 32px 0 32px clamp(0px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-left: 1px solid var(--border);
  }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--smoke);
  }
  .reset {
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--smoke);
    font-family: var(--mono);
    font-size: 13px;
  }
  .reset:hover {
    color: var(--white);
  }
  .log {
    flex: 1 1 auto;
    min-height: 260px;
    max-height: 340px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-right: 8px;
  }
  .log > :global(:first-child) {
    margin-top: auto;
  }
  .log :global(.msg) {
    max-width: 78%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    animation: pop 0.3s ease-out;
  }
  .log :global(.me) {
    align-self: flex-start;
    align-items: flex-start;
  }
  .log :global(.you) {
    align-self: flex-end;
    align-items: flex-end;
  }
  .log :global(.by) {
    font-size: 11px;
    color: var(--smoke);
  }
  .log :global(.bubble) {
    padding: 16px 20px;
    line-height: 1.45;
    background: var(--charcoal);
    font-size: 17px;
  }
  .log :global(.you .bubble) {
    background: var(--red);
    font-size: 19px;
    font-weight: 700;
  }
  .log :global(.typing) {
    align-self: flex-start;
    display: flex;
    gap: 6px;
    padding: 16px 20px;
    background: var(--charcoal);
    font-size: 22px;
    line-height: 1;
  }
  .log :global(.d1) {
    animation: blink 1.2s infinite;
  }
  .log :global(.d2) {
    animation: blink 1.2s 0.2s infinite;
  }
  .log :global(.d3) {
    animation: blink 1.2s 0.4s infinite;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.2;
    }
    40% {
      opacity: 1;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ask {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--white);
    background: transparent;
    color: var(--white);
    font-family: var(--mono);
    font-size: 13px;
    transition: background 0.2s, color 0.2s;
  }
  .ask:hover:not(:disabled) {
    background: var(--white);
    color: var(--ink);
  }
  .ask:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .write {
    border-top: 1px solid var(--border);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .write label {
    font-size: 13px;
    color: var(--muted);
  }
  .write-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }
  textarea {
    flex: 1 1 280px;
    min-height: 64px;
    padding: 14px 16px;
    border: 1px solid var(--white);
    border-radius: 0;
    background: transparent;
    color: var(--white);
    font-size: 18px;
    line-height: 1.4;
    resize: vertical;
  }
  textarea::placeholder {
    color: #5e5e5a;
  }
  .send {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 64px;
    padding: 0 28px;
    background: var(--red);
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
    font-size: 18px;
    transition: background 0.2s;
  }
  .send:hover {
    background: var(--red-deep);
  }
  .note {
    font-size: 12px;
    color: var(--smoke);
  }

  .mob-only,
  .mob-flex {
    display: none;
  }

  /* Phone */
  @media (max-width: 760px) {
    .desk-only {
      display: none !important;
    }
    .desk-flex {
      display: none;
    }
    .mob-only {
      display: block;
    }
    .mob-flex {
      display: flex;
    }
    .contact {
      border-top: 0;
      min-height: 0;
      gap: 0;
    }
    .left {
      flex: 1 1 100%;
      padding: 32px 0 24px;
    }
    h1 {
      font-size: 60px;
    }
    .lede {
      margin-top: 14px;
      font-size: 16px;
    }
    .right {
      flex: 1 1 100%;
      padding: 16px 0 0;
      border-left: 0;
      border-top: 1px solid var(--white);
      gap: 0;
    }
    .chat-head-m {
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }
    .mini {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--red);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 20px;
    }
    .chat-head-m .mono {
      flex: 1 1 auto;
      font-size: 11px;
      line-height: 1.5;
    }
    .name-s {
      font-family: var(--font);
      font-weight: 800;
      font-size: 18px;
    }
    .muted-s {
      color: var(--smoke);
    }
    .chat-head-m .reset {
      font-size: 18px;
      min-width: 44px;
      min-height: 44px;
    }
    .log {
      min-height: 380px;
      max-height: 60vh;
      gap: 12px;
      padding-right: 0;
    }
    .log :global(.msg) {
      max-width: 84%;
    }
    .log :global(.by) {
      display: none;
    }
    .log :global(.bubble) {
      padding: 14px 16px;
      font-size: 16px;
    }
    .log :global(.you .bubble) {
      font-size: 17px;
    }
    .log :global(.typing) {
      padding: 14px 18px;
      font-size: 20px;
    }
    .chips-wrap {
      padding-top: 20px;
      margin: 0 calc(-1 * var(--gutter));
    }
    .swipe {
      padding: 0 var(--gutter) 8px;
      font-size: 11px;
      color: var(--smoke);
    }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 0 var(--gutter);
      scrollbar-width: none;
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
    .ask {
      flex: 0 0 auto;
      font-size: 12px;
      padding: 12px 14px;
    }
    .write {
      margin-top: 24px;
      gap: 0;
    }
    .write label {
      display: block;
      margin-bottom: 8px;
      font-size: 12px;
    }
    .write-row {
      flex-direction: column;
    }
    textarea {
      flex: none;
      width: 100%;
      min-height: 0;
      padding: 14px;
      font-size: 17px;
      resize: none;
    }
    .send {
      min-height: 56px;
      margin-top: 10px;
      font-size: 17px;
    }
    .note {
      margin-top: 8px;
      font-size: 11px;
    }
  }
</style>
